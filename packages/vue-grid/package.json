{
  "name": "@nocopypaste/vue-grid",
  "version": "0.7.0",
  "description": "CSS-Grid based data grid for Vue 3 with opt-in features, pluggable cell renderers, sub-grids and CSS-variable theming — documented for coding agents (AGENTS.md, llms.txt, JSON Schema, validator).",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "vue",
    "vue3",
    "grid",
    "table",
    "data-grid",
    "css-grid",
    "subgrid",
    "ai",
    "llm",
    "agents",
    "mcp"
  ],
  "files": [
    "dist",
    "agent",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "llms-full.txt",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/vue-grid.css",
    "./base.css": "./dist/base.css",
    "./theme.css": "./dist/theme.css",
    "./core.css": "./dist/core.css",
    "./renderers.css": "./dist/renderers.css",
    "./agent": {
      "types": "./dist/types/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./agent/api.json": "./agent/api.json",
    "./agent/grid-config.schema.json": "./agent/grid-config.schema.json",
    "./AGENTS.md": "./AGENTS.md",
    "./llms.txt": "./llms.txt",
    "./llms-full.txt": "./llms-full.txt",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/gen-agent.mjs && vite build && vue-tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "gen:agent": "node scripts/gen-agent.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eboye/eboye-vue-grid.git",
    "directory": "packages/vue-grid"
  },
  "homepage": "https://github.com/eboye/eboye-vue-grid/tree/main/packages/vue-grid#readme",
  "bugs": {
    "url": "https://github.com/eboye/eboye-vue-grid/issues"
  },
  "author": "eboye"
}
