{
  "name": "@eboye/vue-grid",
  "version": "0.1.0",
  "description": "CSS-Grid based data grid for Vue 3 with pluggable cell renderers, sub-grids and CSS-variable theming.",
  "license": "MIT",
  "type": "module",
  "keywords": ["vue", "vue3", "grid", "table", "data-grid", "css-grid", "subgrid"],
  "files": ["dist", "README.md"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/vue-grid.css"
  },
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
