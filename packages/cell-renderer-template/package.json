{
  "name": "@nocopypaste/vue-grid-renderer-template",
  "version": "0.24.0",
  "description": "Boilerplate cell-renderer addon for @nocopypaste/vue-grid: a star rating renderer. Copy this package to start your own.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/rating.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@nocopypaste/vue-grid": "^0.24.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@nocopypaste/vue-grid": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eboye/eboye-vue-grid.git",
    "directory": "packages/cell-renderer-template"
  },
  "homepage": "https://github.com/eboye/eboye-vue-grid/tree/main/packages/cell-renderer-template#readme",
  "bugs": {
    "url": "https://github.com/eboye/eboye-vue-grid/issues"
  },
  "author": "eboye"
}
