{
  "name": "eboye-vue-grid-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/vue-grid",
    "packages/vue-grid-mcp",
    "packages/cell-renderer-template",
    "playground",
    "site"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @nocopypaste/vue-grid && npm run build -w @nocopypaste/vue-grid-renderer-template",
    "dev": "npm run dev -w playground",
    "test": "npm run test -w @nocopypaste/vue-grid && npm run test -w @nocopypaste/vue-grid-renderer-template && npm run test -w @nocopypaste/vue-grid-mcp",
    "typecheck": "npm run typecheck --workspaces --if-present && vue-tsc --noEmit -p stories",
    "lint": "eslint .",
    "format": "prettier --write .",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "e2e:storybook": "playwright test -c e2e/storybook.config.ts",
    "benchmark:grid": "node scripts/benchmark-grid.mjs",
    "showcase": "node scripts/record-showcase.mjs",
    "screenshots": "node scripts/renderer-screenshots.mjs",
    "format:check": "prettier --check .",
    "site": "npm run dev -w site"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/vue3-vite": "^10.6.8",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^31.0.1",
    "lightningcss": "^1.33.0",
    "prettier": "^3.10.1",
    "storybook": "^10.6.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14"
  }
}
