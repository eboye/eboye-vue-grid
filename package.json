{
  "name": "eboye-vue-grid-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/vue-grid",
    "packages/cell-renderer-template",
    "playground"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @eboye/vue-grid && npm run build -w @eboye/vue-grid-renderer-template",
    "dev": "npm run dev -w playground",
    "test": "npm run test -w @eboye/vue-grid && npm run test -w @eboye/vue-grid-renderer-template",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14"
  }
}
